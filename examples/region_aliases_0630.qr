fn select<'a>(condition: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    let first = left;
    let second = right;
    if condition { first } else { second }
}

fn forward<'a>(condition: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    select(condition, left, right)
}

fn main() {
    let a: i64 = 5;
    let b: i64 = 17;
    let chosen = forward(false, &a, &b);
    let q = qubit();
    rx(*chosen, q);
}
