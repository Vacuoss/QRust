fn choose<'a>(flag: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    if flag { left } else { right }
}

fn forward<'a>(flag: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    choose(flag, left, right)
}

fn main() {
    let left: i64 = 8;
    let right: i64 = 13;
    let selected = forward(false, &left, &right);
    let q = qubit();
    rz(*selected, q);
}
