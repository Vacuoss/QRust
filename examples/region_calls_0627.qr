fn choose<'a>(pick:bool,left:&'a i64,right:&'a i64)->&'a i64 {
    if pick {left} else {right}
}
fn reborrow<'a>(value:&'a i64)->&'a i64 { &*value }
fn main() {
    let a:i64=4;
    let b:i64=9;
    let selected=choose(false,&a,&b);
    let q=qubit();
    rx(*selected,q);
    let reference=reborrow(&a);
    ry(*reference,q);
}
