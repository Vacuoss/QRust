fn choose<'a>(condition: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    match condition { true => { left }, false => { right } }
}

fn pass<'a>(condition: bool, left: &'a i64, right: &'a i64) -> &'a i64 {
    choose(condition, left, right)
}

fn main() {
    let a: i64 = 7;
    let b: i64 = 19;
    let selected = pass(false, &a, &b);
    let q = qubit();
    rx(*selected, q);
}
